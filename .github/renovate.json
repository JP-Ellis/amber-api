{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "pre-commit": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": true,
  "packageRules": [
    {
      "description": "rust-toolchain.toml and mise.toml pin the same toolchain under different dependency names. Grouping them lands both pins in one PR; separately, each PR leaves the two pins disagreeing.",
      "matchDepNames": ["rust", "core:rust"],
      "groupName": "rust toolchain"
    },
    {
      "matchPackageNames": ["taiki-e/install-action"],
      "schedule": "* 0-4 * * 1"
    }
  ]
}
